# Copy to .env for local overrides. Never commit real secrets.
# All values below are development defaults.

# Signing key for access tokens and the audit HMAC chain.
# Production: use asymmetric keys (RS256/EdDSA) and a real secret manager.
MCPGATE_JWT_SECRET=local-development-secret-change-before-deploy

# OAuth identity of this server
MCPGATE_ISSUER=http://127.0.0.1:8000
MCPGATE_RESOURCE=http://127.0.0.1:8000/mcp

# Token lifetimes (seconds)
MCPGATE_ACCESS_TTL=300
MCPGATE_REFRESH_TTL=3600

# Per-identity token bucket
MCPGATE_RATE_CAPACITY=20
MCPGATE_RATE_REFILL=5

# Paths
MCPGATE_DB=data/mcpgate.sqlite3
MCPGATE_POLICY=policy.yaml

# Bind address
MCPGATE_HOST=127.0.0.1
MCPGATE_PORT=8000
